<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_sage"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/back"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textDetailWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/ink"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetailRomanization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_meaning"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetailMeaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_example"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetailExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textDetailExampleMeaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/peach"
            android:enabled="false"
            android:text="@string/share_word"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/textDetailMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="20dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>