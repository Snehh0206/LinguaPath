<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_word_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <TextView
        android:id="@+id/textArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="@string/arrow"
        android:textColor="@color/ink"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/textWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/textArrow"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textRomanization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textWord"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/textArrow"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/textMeaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textRomanization"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:layout_toStartOf="@id/textArrow"
        android:textColor="@color/ink"
        android:textSize="16sp" />

</RelativeLayout>