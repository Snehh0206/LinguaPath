<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_word_card"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/textWordEmoji"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_sticker"
        android:gravity="center"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRomanization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/textMeaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/buttonSave"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_sticker"
        android:clickable="true"
        android:contentDescription="@string/topic_save_description"
        android:focusable="true"
        android:gravity="center"
        android:text="⭐"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/buttonSpeak"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_sticker"
        android:clickable="true"
        android:contentDescription="@string/speak_description"
        android:focusable="true"
        android:gravity="center"
        android:text="🔊"
        android:textSize="18sp" />
</LinearLayout>