<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_sticker"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/quiz_close"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="invisible" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressQuiz"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:progressDrawable="@drawable/progress_rounded" />

            <TextView
                android:id="@+id/textLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/quiz_loading"
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/groupQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textQuestionType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/buttonListen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_sky"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/quiz_listen_button"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/buttonShowWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/quiz_show_word"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/textPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPromptSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/textHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="16sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/groupBuild"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_build_answer_label"
                        android:textColor="@color/ink_soft"
                        android:textSize="12sp" />

                    <com.example.linguapath.view.FlowLayout
                        android:id="@+id/flowAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_word_card"
                        android:minHeight="72dp"
                        android:padding="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/quiz_build_bank_label"
                        android:textColor="@color/ink_soft"
                        android:textSize="12sp" />

                    <com.example.linguapath.view.FlowLayout
                        android:id="@+id/flowBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="4dp" />

                    <Button
                        android:id="@+id/buttonCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/accent"
                        android:text="@string/quiz_check"
                        android:textColor="@color/ink" />
                </LinearLayout>
                <TextView
                    android:id="@+id/option0"
                    style="@style/QuizOption" />

                <TextView
                    android:id="@+id/option1"
                    style="@style/QuizOption" />

                <TextView
                    android:id="@+id/option2"
                    style="@style/QuizOption" />

                <TextView
                    android:id="@+id/option3"
                    style="@style/QuizOption" />

                <TextView
                    android:id="@+id/textFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/peach"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textResultEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="64sp" />

                <TextView
                    android:id="@+id/textResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textResultScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/textResultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/ink_soft"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonResultPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/ink" />

                <Button
                    android:id="@+id/buttonResultSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/sage"
                    android:text="@string/quiz_review_words"
                    android:textColor="@color/ink" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.example.linguapath.view.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>